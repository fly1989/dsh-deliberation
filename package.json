{
  "name": "dsh-deliberation",
  "version": "0.1.0",
  "description": "Primary-controlled deliberation and opt-in masked review for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fly1989/dsh-deliberation.git"
  },
  "bugs": {
    "url": "https://github.com/fly1989/dsh-deliberation/issues"
  },
  "homepage": "https://github.com/fly1989/dsh-deliberation#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent",
    "subagent",
    "deliberation",
    "reasoning",
    "masked-review",
    "test-time-compute"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mid-fork-provider": {
      "types": "./lib/mid-fork-provider.d.ts",
      "default": "./lib/mid-fork-provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "docs/CORDIS-HARNESS-MAPPING.zh-CN.md",
    "docs/DEFERRED.zh-CN.md",
    "docs/FLOW.zh-CN.md",
    "docs/MASKED-REVIEW-RESEARCH-NOTES.zh-CN.md",
    "docs/REASONING-MASKED-FORK-EXPERIMENT.zh-CN.md",
    "docs/TERMS.zh-CN.md",
    "examples/*.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "release:check": "npm run check && npm pack --dry-run --ignore-scripts",
    "prepare": "npm run build",
    "prepack": "npm run check"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-subagent": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-timeout": ">=0.1.1-rc.2 <0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^24.10.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
